{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // transcriptor/src imports with `.ts` extensions (Node runs it as it is, for its benches):
    // rewritten to `.js` in what ts-loader emits, which webpack resolves back to the `.ts` file
    // (resolve.extensionAlias in webpack.config.js)
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*", "transcriptor/src/**/*"]
}
