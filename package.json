{
  "name": "cadence",
  "version": "1.0.0",
  "description": "A local-first spaced repetition app for building and maintaining a long-term repertoire of anything, with extra tools for Irish traditional musicians.",
  "author": "Batpapa",
  "repository": {
    "type": "git",
    "url": "https://github.com/Batpapa/Cadence.git"
  },
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "cap:run": "npm run build && cap run android",
    "cap:dev": "cap run android --live-reload --host localhost --port 3002 --forwardPorts 3002:3002",
    "test": "vitest run",
    "test:nightly": "vitest run",
    "deploy": "git add . && (git diff --cached --quiet && echo 'Nothing to commit.' || git commit -m \"${npm_config_msg:-deploy}\") && git push",
    "sweep": "vitest run --config vitest.sweep.config.ts",
    "ranking": "vitest run --config vitest.ranking.config.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/dom-webcodecs": "^0.1.18",
    "@types/lz-string": "^1.3.34",
    "autoprefixer": "^10.4.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "fix-webm-duration": "^1.0.6",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^26.1.0",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss": "^8.4.0",
    "postcss-loader": "^8.1.0",
    "style-loader": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "ts-loader": "^9.5.0",
    "ts-prune": "^0.10.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-updater": "^8.52.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@preact/signals": "^2.9.0",
    "abcjs": "^6.7.0",
    "dompurify": "^3.4.15",
    "idb": "^8.0.3",
    "lz-string": "^1.5.0",
    "marked": "^18.0.0",
    "mediabunny": "^1.56.2",
    "music-metadata": "^11.15.0",
    "pdfjs-dist": "^6.3.289",
    "preact": "^10.29.1",
    "qrcode-generator": "^2.0.4",
    "signalsmith-stretch": "^1.3.2",
    "web-demuxer": "^4.0.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
